# Copy to .env and fill in. Nothing in this repo reads real secrets from
# anywhere else — whatever you put here (or set as real env vars on
# Railway/Render) is the only source of truth.

DATABASE_URL=postgresql://primedox:primedox@localhost:5432/primedox
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string

# Test mode vs live mode is decided entirely by which prefix you paste here:
# a key starting with sk_test_ stays in test mode, sk_live_ goes live. Leave
# blank for local dev (Stripe-dependent routes return a 503 until set).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

SENDGRID_API_KEY=

SUPABASE_URL=
SUPABASE_KEY=
