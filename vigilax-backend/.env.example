# ── VIGILAX Sentinel — Environment Configuration ──────────────────────────────
# Copy to .env and fill in your values

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3002
# Comma-separated allowed CORS origins
CORS_ORIGINS=https://vigilax.com,https://primedoxaihq.com,https://franciscoholdingsinc.com

# ── API Keys (comma-separated — first key is primary) ────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIGILAX_API_KEYS=your-api-key-here,second-key-optional
ADMIN_SECRET=your-admin-secret-here

# ── Email Alerts ──────────────────────────────────────────────────────────────
ALERT_EMAIL=franciscoderek7@gmail.com

# Option A: SendGrid (recommended for production)
SENDGRID_API_KEY=SG.xxx

# Option B: SMTP (Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# ── SMS Alerts (critical score ≥ 90) ─────────────────────────────────────────
# Twilio — get at twilio.com
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
SMS_ALERT_NUMBER=+1xxxxxxxxxx

# ── Slack Alerts ──────────────────────────────────────────────────────────────
# Create webhook at: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_CHANNEL=#vigilax-alerts

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Railway can provision: railway.app → Add Service → Database → PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/vigilax_db

# ── API Connectors (all optional — activate when keys available) ──────────────

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Meta / Facebook Ads
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=

# Amazon Advertising
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=

# Twitter/X API v2
TWITTER_BEARER_TOKEN=

# Instagram (via Facebook Graph API)
IG_ACCESS_TOKEN=

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable live domain verification (makes outbound HTTP requests)
VERIFY_DOMAINS=false
