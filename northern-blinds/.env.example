# Northern Blinds — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Supabase Postgres direct connection) ────────────────────────────
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Email addresses for lead notifications (no real addresses here — fill in .env.local)
NOTIFY_EMAIL_TO=owner@example.com
NOTIFY_EMAIL_FROM=noreply@northernblinds.example.com

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
