# Francisco Holdings Subscription Backend — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# ── Unlock Code Secret ────────────────────────────────────────────────────────
# Generate a strong random string: python3 -c "import secrets; print(secrets.token_hex(32))"
UNLOCK_SECRET_KEY=your-strong-random-secret-here

# ── PayPal ────────────────────────────────────────────────────────────────────
# Get from developer.paypal.com → My Apps & Credentials
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ── Square ────────────────────────────────────────────────────────────────────
# Get from developer.squareup.com → Applications → Webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=franciscoderek7@gmail.com
SMTP_PASS=your-gmail-app-password-16-chars

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local/small scale. For production: use PostgreSQL via DATABASE_URL
DB_PATH=subscriptions.db

# ── Contact ───────────────────────────────────────────────────────────────────
DEREK_EMAIL=franciscoderek7@gmail.com
