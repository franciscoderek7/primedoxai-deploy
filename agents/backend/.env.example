# PrimeDox AI Backend — Environment Configuration
# Copy to .env and fill in your values

# ─── LLM Backend Selection ────────────────────────────────────────────────────
# Options: "openai" | "gemma" | "hybrid"
#   openai  — all agents use GPT-4o via OpenAI API
#   gemma   — all agents use gemma3:27b via local Ollama instance
#   hybrid  — premium agents (phoenix/counsel/barrister/ledger/archivist/alpha)
#             use GPT-4o; all others use gemma3:27b
LLM_BACKEND=hybrid

# ─── OpenAI (required for openai or hybrid mode) ─────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Gemma / Ollama (required for gemma or hybrid mode) ──────────────────────
# URL of your Ollama instance (local or RunPod/Vast.ai)
GEMMA_BASE_URL=http://localhost:11434/v1
# Model tag loaded in Ollama
GEMMA_MODEL=gemma3:27b

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=https://primedoxaihq.com,https://franciscoholdingsinc.com,https://omniaguard.com,https://ccldr.net,http://localhost:3000
# Secret key for optional admin routes (generate with: openssl rand -hex 32)
ADMIN_SECRET=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Swarm ───────────────────────────────────────────────────────────────────
# Max agents that can be fanned out in a single /swarm request
SWARM_MAX_AGENTS=8

# ─── Chinese AI Stack (optional — powers /generate-motion, /translate, /suggest-fix) ──
# Fallback chain tries these in order: DeepSeek -> Qwen -> GLM -> Kimi -> OpenAI (above).
# Leave any of these blank and that provider is skipped automatically — no code
# changes needed. Verify the *_MODEL value against each vendor's current docs
# before relying on it; defaults below are starting points, not guarantees.
#
# DeepSeek — sign up at platform.deepseek.com (or siliconflow.cn, cheaper proxy)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
#
# Qwen — sign up at siliconflow.cn (or dashscope.console.aliyun.com for Alibaba direct)
QWEN_API_KEY=
QWEN_BASE_URL=https://api.siliconflow.cn/v1
QWEN_MODEL=Qwen/Qwen2.5-72B-Instruct
#
# GLM — sign up at open.bigmodel.cn or z.ai (or siliconflow.cn)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
#
# Kimi — sign up at platform.moonshot.cn
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

# ─── Claude / Anthropic (Task 7 — first in AI routing chain) ─────────────────
# Get at: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Stripe (Task 4 — webhooks + payments) ───────────────────────────────────
# Secret key: dashboard.stripe.com → Developers → API Keys → Secret key
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret: dashboard.stripe.com → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── JWT Auth (Task 6) ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Supabase Service Key (backend DB writes — NOT the anon key) ─────────────
# Get at: supabase.com/dashboard → project → Settings → API → service_role key
SUPABASE_URL=https://ilmlnehehfcxwlurzfxd.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
