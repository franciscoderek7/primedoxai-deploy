# DEF Property Maintenance — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Primary QR code destination — set to production URL when live
DEF_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# ── Dylan's contact — fill when verified ─────────────────────────────────
# These drive the website, digital card, and vCard. One source of truth.
# DEF_PHONE=TO-BE-PROVIDED
# DEF_EMAIL=TO-BE-PROVIDED
# DEF_WEBSITE_URL=TO-BE-PROVIDED

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── AI (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL_TO=owner@example.com
NOTIFY_EMAIL_FROM=noreply@def-pm.example.com

# ── FHI Council integration — adapters only, not live ────────────────────
# FHI_COUNCIL_ENDPOINT=TO-BE-PROVIDED
# FHI_COUNCIL_API_KEY=TO-BE-PROVIDED
