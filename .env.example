# Template for the FloorManager runtime + FastAPI backend.
# Copy to .env.development / .env.staging / .env.production and fill in
# real values per environment. Never commit real secrets — see
# .env.production, which is gitignored once it holds real values.

# Base URL the frontend's FloorManager fetches floor state from.
API_BASE_URL=http://localhost:8000/api

# CORS origins the backend accepts requests from (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

ENVIRONMENT=development
