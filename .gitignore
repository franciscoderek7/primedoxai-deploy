.claude/

# Production env file is committed once as a placeholder template (see
# .env.production's own header comment) — gitignored from here on so
# real secrets, once added, are never pushed.
.env.production

# Real local secrets (Supabase keys, Stripe live key, etc.) — never commit.
# .env.example / .env.local.example are templates and are NOT covered by this.
.env
.env.local

__pycache__/
*.pyc
